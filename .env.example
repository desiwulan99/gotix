# ==============================================================================
# GOTIX — Environment Variables Configuration Template
# ==============================================================================
# Salin file ini menjadi .env baik di root, backend, maupun frontend sesuai kebutuhan.
# JANGAN PERNAH menyertakan file .env yang berisi credential asli ke git repository!

# --- POSTGRES DATABASE CONFIGURATION ---
POSTGRES_USER=gotix_user
POSTGRES_PASSWORD=gotix_password
POSTGRES_DB=gotix_db

# --- BACKEND API CONFIGURATION ---
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://gotix_user:gotix_password@localhost:5432/gotix_db?schema=public

# JWT Security
JWT_SECRET=super_secret_jwt_key_for_gotix_subtle_gothic_luxury_2026
JWT_EXPIRES_IN=7d

# Webhook Security (HMAC SHA-256 Secret)
WEBHOOK_SECRET=gotix_webhook_hmac_secret_key_2026

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Expiry Worker Interval (dalam milidetik, default: 30000 = 30 detik)
EXPIRY_INTERVAL_MS=30000

# Reservation Duration (dalam menit, default: 15 menit)
ORDER_EXPIRY_MINUTES=15

# --- FRONTEND CONFIGURATION ---
VITE_API_BASE_URL=/api
