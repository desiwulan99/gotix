// Prisma Schema for GOTIX Ticketing System
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum WebhookStatus {
  PROCESSED
  IGNORED
  FAILED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role      @default(BUYER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders       Order[]
  tickets      Ticket[]

  @@index([email])
}

model Event {
  id          String      @id @default(uuid())
  title       String
  description String      @db.Text
  location    String
  startsAt    DateTime
  imageUrl    String?     @db.Text
  status      EventStatus @default(PUBLISHED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  ticketTypes TicketType[]
  orders      Order[]

  @@index([status])
  @@index([startsAt])
}

model TicketType {
  id            String      @id @default(uuid())
  eventId       String
  name          String      // e.g. "Regular", "VIP"
  price         Decimal     @db.Decimal(12, 2)
  quota         Int         // Total kapasitas fisik tiket
  reservedCount Int         @default(0) // Kuota ditahan + terjual (sisa = quota - reservedCount)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  tickets       Ticket[]

  @@index([eventId])
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  eventId     String
  status      OrderStatus @default(PENDING_PAYMENT)
  totalAmount Decimal     @db.Decimal(12, 2)
  expiresAt   DateTime    // Waktu habis masa penahanan tiket (15 menit)
  paidAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  event       Event       @relation(fields: [eventId], references: [id])
  items       OrderItem[]
  payment     Payment?
  tickets     Ticket[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([eventId])
}

model OrderItem {
  id           String     @id @default(uuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2) // Snapshot harga saat dipesan

  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets      Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String        @unique // Satu order hanya memiliki satu payment sukses
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  paymentMethod String        @default("SIMULATED_BANK_TRANSFER")
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Ticket {
  id           String       @id @default(uuid())
  code         String       @unique // Unique ticket code acak kriptografis, e.g. "GTX-7K9A3F21B4C9"
  orderId      String
  orderItemId  String
  seq          Int          // Urutan 1..N dalam order item
  ticketTypeId String
  userId       String
  status       TicketStatus @default(VALID)
  issuedAt     DateTime     @default(now())

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([orderItemId, seq])
  @@index([code])
  @@index([userId])
  @@index([orderId])
}

model WebhookEvent {
  id          String        @id @default(uuid())
  eventId     String        @unique // Idempotency key eksternal dari payment gateway
  eventType   String
  payload     Json
  status      WebhookStatus @default(PROCESSED)
  receivedAt  DateTime      @default(now())

  @@index([eventId])
}
